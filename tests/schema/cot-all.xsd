  <xs:include schemaLocation="contact.xsd"/>
  <xs:include schemaLocation="track.xsd"/>
  <xs:include schemaLocation="sensor.xsd"/>
  <xs:include schemaLocation="link.xsd"/>
  <xs:include schemaLocation="remarks.xsd"/>
</xs:schema>
